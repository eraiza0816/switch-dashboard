{
  "name": "switch-dashboard-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/dashboard.ts ./src/logs.ts ./src/backups.ts ./src/map.ts ./src/api_docs.ts --outdir ../static/dist --target browser --minify --splitting",
    "watch": "bun build ./src/dashboard.ts ./src/logs.ts ./src/backups.ts --outdir ../static/dist --target browser --watch",
    "typecheck": "bun tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "bun": "^1.3.14",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "bun@1.3.14": true
  }
}
