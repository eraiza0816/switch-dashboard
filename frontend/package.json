{
  "name": "switch-dashboard-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/dashboard.ts ./src/logs.ts ./src/backups.ts --outdir ../static/dist --target browser --minify --splitting",
    "watch": "bun build ./src/dashboard.ts ./src/logs.ts ./src/backups.ts --outdir ../static/dist --target browser --watch",
    "typecheck": "bun tsc --noEmit"
  },
  "devDependencies": {
    "bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "bun@1.3.14": true
  }
}
