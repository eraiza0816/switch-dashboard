FROM oven/bun:1 AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN bun install
COPY frontend/ ./
RUN bun run build

FROM golang:1.26-alpine AS builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /app/static/dist/ ./static/dist/
RUN CGO_ENABLED=1 go build -ldflags="-linkmode external -extldflags -static" -o switch-dashboard ./cmd/switch-dashboard/

FROM mcr.microsoft.com/playwright:v1.62.0-jammy
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/switch-dashboard /switch-dashboard
COPY --from=builder /build/templates/ /templates/
COPY --from=builder /build/static/ /static/
COPY frontend/e2e/ /e2e/
COPY frontend/package.json frontend/package-lock.json /e2e/
WORKDIR /e2e
RUN npm install && npx playwright install chromium 2>&1 | tail -5
RUN echo '{"title":"E2E Test","refresh_interval":30,"switches":[{"name":"Test Switch","ip":"192.168.10.247","password":"1234","model":"RTLPlayground","port_count":8,"enabled":true}]}' > /config.json
ENV LISTEN=:8081
CMD /switch-dashboard & sleep 2 && npx playwright test --config=playwright.config.ts
